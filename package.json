{
  "name": "commit-generator",
  "version": "0.1.0",
  "description": "CLI that generates Conventional Commit messages from staged Git changes using Ollama.",
  "type": "module",
  "bin": {
    "commit-gen": "./out/cli.js",
    "cg": "./out/cli.js",
    "cgm": "./out/cli.js"
  },
  "files": [
    "out",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run build",
    "dev": "npm run build -- --pretty false && node out/cli.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "inquirer": "^9.3.8",
    "simple-git": "^3.28.0"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  }
}
